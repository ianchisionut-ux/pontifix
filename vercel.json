{
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "softj", "format": "url", "env": "SOFTJ_INTERNAL_URL" }
      ]
    },
    "softj": {
      "root": "services/softj",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "chat.elmont.ro" }], "destination": "/chat", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/cron/efactura", "schedule": "0 6 * * *" },
    { "path": "/api/cron/deer-borderou", "schedule": "0 7 * * *" }
  ]
}
