model Plan {
  id                  String   @id @default(cuid())
  name                String
  displayName         String
  priceMonthly        Decimal
  stripePriceId       String
  maxChannels         Int
  maxBookingsPerMonth Int?
  maxStaff            Int?
  features            String[]
  active              Boolean  @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  business             Business           @relation(fields: [businessId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum EmployeeCategory {
  TESA
  PRODUCTIE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum TimeEntrySource {
  WEB
  MANUAL
}

enum LeaveType {
  VACATION
  MEDICAL
  PERSONAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceDayStatus {
  PRESENT
  ABSENT
  VACATION
  MEDICAL
  DAY_OFF
  REMOTE
}

model AttendanceEmployee {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String?           @unique
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  email            String?
  phone            String?
  position         String?
  department       String?
  category         EmployeeCategory  @default(PRODUCTIE)
  employmentType   EmploymentType    @default(FULL_TIME)
  weeklyHours      Float             @default(40)
  dailyHours       Float             @default(8)
  sortOrder        Int               @default(0)
  active           Boolean           @default(true)
  hiredAt          DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  timeEntries      TimeEntry[]
  leaveRequests    LeaveRequest[]
  dailyAttendances DailyAttendance[]

  @@unique([businessId, email])
  @@index([businessId, active])
}

model DailyAttendance {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       AttendanceEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate       DateTime            @db.Date
  status         AttendanceDayStatus
  hours          Float               @default(0)
  note           String?
  leaveRequestId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([employeeId, workDate])
  @@index([businessId, workDate])
  @@index([leaveRequestId])
}

model TimeEntry {
  id           String             @id @default(cuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     AttendanceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int                @default(0)
  source       TimeEntrySource    @default(WEB)
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([businessId, clockIn])
  @@index([employeeId, clockIn])
}

model LeaveRequest {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String
  employee   AttendanceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus        @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([businessId, status])
  @@index([employeeId, startDate])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ApprovalStatus {
  REQUIRED
  SUBMITTED
  OBTAINED
  NOT_REQUIRED
}

model Project {
  id                              String            @id @default(cuid())
  businessId                      String
  business                        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                            String
  certificateNumber               String?
  certificateDate                 DateTime?         @db.Date
  beneficiary                     String?
  beneficiaryPhone                String?
  address                         String?
  description                     String?
  status                          ProjectStatus     @default(ACTIVE)
  constructionAuthorizationStatus ApprovalStatus    @default(REQUIRED)
  documentUrl                     String?
  documentName                    String?
  uploadedByEmail                 String?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  approvals                       ProjectApproval[]

  @@index([businessId, status])
  @@index([businessId, updatedAt])
}

model ProjectApproval {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  institution  String?
  status       ApprovalStatus @default(REQUIRED)
  submittedAt  DateTime?      @db.Date
  obtainedAt   DateTime?      @db.Date
  notes        String?
  documentUrl  String?
  documentName String?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId, sortOrder])
}
