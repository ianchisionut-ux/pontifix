generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Business & auth
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Business {
  id                     String            @id @default(cuid())
  name                   String
  slug                   String            @unique
  category               BusinessType
  contactPhone           String?
  city                   String?
  latitude               Float?
  longitude              Float?
  address                String?
  heroImageUrl           String?
  publicListed           Boolean           @default(true)
  accountActive          Boolean           @default(true)
  teamSize               Int               @default(1)
  paymentProcessor       PaymentProcessor? // NULL = plata online dezactivatÄƒ pentru acest business
  stripeSecretKey        String?
  stripeWebhookSecret    String?
  netopiaApiKey          String?
  netopiaPosSignature    String?
  netopiaPublicKey       String?
  netopiaIsLive          Boolean           @default(false)
  euplatescMerchantId    String?
  euplatescSecretKey     String?
  euplatescIsLive        Boolean           @default(false)
  timezone               String            @default("Europe/Bucharest")
  slotIntervalMinutes    Int? // null = automat, dupÄƒ durata fiecÄƒrui serviciu; altfel interval fix (10/15/30...)
  minLeadTimeMinutes     Int               @default(120) // rezervÄƒrile/anulÄƒrile din exterior (bot, site) nu se pot face mai aproape de aceastÄƒ limitÄƒ; admin-ul manual e scutit
  reminderMinutesBefore  Int               @default(1440) // cu cÃ¢t timp Ã®nainte de programare trimitem reminder-ul + cererea de confirmare pe WhatsApp (implicit 24h)
  operatorSilenceMinutes Int               @default(30) // cÃ¢t timp tace botul complet dupÄƒ ce clientul cere un operator, ca omul sÄƒ poatÄƒ prelua conversaÈ›ia fÄƒrÄƒ suprapuneri
  botBookingEnabled      Boolean           @default(true) // dacÄƒ e oprit, opÈ›iunea "FÄƒ o programare" dispare din meniul de start al botului â€” rÄƒmÃ¢n doar Operator È™i link spre site
  break1Start            String? // pauze zilnice (ex: masÄƒ) â€” aceleaÈ™i ore Ã®n fiecare zi lucrÄƒtoare, nu se pot face programÄƒri
  break1End              String?
  break2Start            String?
  break2End              String?
  break3Start            String?
  break3End              String?
  brandColor             String? // culoarea de accent aleasÄƒ de business pentru pagina publicÄƒ (hex); null = culoarea implicitÄƒ bookeasy
  planName               String? // numele planului, gestionat manual de admin pÃ¢nÄƒ se configureazÄƒ plata online
  billingStatus          BillingStatus     @default(NEPLATIT)
  billingNote            String? // notÄƒ liberÄƒ pentru superadmin (ex: "plÄƒtit cash august")
  onboardingStep         Int               @default(1)
  onboardingDone         Boolean           @default(false)
  stripeCustomerId       String?
  googlePlaceId          String?
  rating                 Decimal?
  reviewCount            Int?
  createdAt              DateTime          @default(now())

  users                     User[]
  staff                     Staff[]
  resources                 Resource[]
  services                  Service[]
  customers                 Customer[]
  bookings                  Booking[]
  googleCalendarConnections GoogleCalendarConnection[]
  waitlistEntries           WaitlistEntry[]
  supportTickets            SupportTicket[]
  chatMessages              ChatMessage[]
  messageTemplates          MessageTemplate[]
  channels                  Channel[]
  workingHours              WorkingHours[]
  conversations             Conversation[]
  reviews                   Review[]
  practitioners             Practitioner[]
  patientDocuments          PatientDocument[]
  medicalLetters            MedicalLetter[]
  photos                    BusinessPhoto[]
  blockedSlots              BlockedSlot[]
  subscription              Subscription?
  missedMessageAlerts       MissedMessageAlert[]
  employees                 AttendanceEmployee[]
  timeEntries               TimeEntry[]
  leaveRequests             LeaveRequest[]
  dailyAttendances          DailyAttendance[]
  projects                  Project[]
}

enum BillingStatus {
  GRATUIT // cont demo/de test, nu se taxeazÄƒ
  NEPLATIT // implicit â€” cont nou, Ã®ncÄƒ nu s-a stabilit plata
  PLATIT
  RESTANT
}

enum PaymentProcessor {
  STRIPE
  NETOPIA
  EUPLATESC
}

enum BusinessType {
  SALON
  EVENT_VENUE
  HOTEL
  PENSIUNE
  CLINICA
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  role                Role                 @default(OWNER)
  businessId          String?
  business            Business?            @relation(fields: [businessId], references: [id])
  passwordResetTokens PasswordResetToken[]
  employeeProfile     AttendanceEmployee?

  @@index([businessId])
}

enum Role {
  OWNER
  STAFF
  SUPER_ADMIN
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Resources: staff (SALON) / resources (EVENT_VENUE)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Staff {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  active     Boolean   @default(true)
  bookings   Booking[]
}

model Resource {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  capacity   Int?
  basePrice  Decimal?
  bookings   Booking[]
}

model Service {
  id              String                @id @default(cuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id])
  name            String
  type            ServiceType           @default(APPOINTMENT)
  durationMin     Int?
  price           Decimal?
  active          Boolean               @default(true)
  requiresDeposit Boolean               @default(false)
  depositAmount   Decimal?
  bookings        Booking[]
  practitioners   ServicePractitioner[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId, active])
}

enum ServiceType {
  APPOINTMENT
  VENUE_RENTAL
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Customers & bookings
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Customer {
  id              String                @id @default(cuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id])
  name            String?
  phone           String
  email           String?
  instagramUserId String?
  facebookUserId  String?
  notes           String?
  dateOfBirth     DateTime? // relevant medical, folosit doar de clinici â€” niciodatÄƒ expus public
  allergies       String? // alergii cunoscute â€” cÃ¢mp separat, vizibil clar pe fiÈ™Äƒ
  medicalNotes    String? // istoric medical/notÄƒ liberÄƒ â€” vizibilÄƒ STRICT Ã®n dashboard-ul clinicii
  createdAt       DateTime              @default(now())
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  medicalRecord   PatientMedicalRecord?
  documents       PatientDocument[]
  medicalLetters  MedicalLetter[]

  @@unique([businessId, phone])
  @@unique([businessId, instagramUserId])
  @@unique([businessId, facebookUserId])
}

model Booking {
  id                      String        @id @default(cuid())
  businessId              String
  business                Business      @relation(fields: [businessId], references: [id])
  customerId              String
  customer                Customer      @relation(fields: [customerId], references: [id])
  serviceId               String
  service                 Service       @relation(fields: [serviceId], references: [id])
  staffId                 String?
  staff                   Staff?        @relation(fields: [staffId], references: [id])
  resourceId              String?
  resource                Resource?     @relation(fields: [resourceId], references: [id])
  practitionerId          String? // doar pentru afaceri de tip CLINICA â€” medicul ales (opÈ›ional, dacÄƒ lipseÈ™te = orice medic disponibil)
  practitioner            Practitioner? @relation(fields: [practitionerId], references: [id])
  startAt                 DateTime
  endAt                   DateTime
  status                  BookingStatus @default(PENDING)
  sequenceNumber          Int? // numÄƒrul rezervÄƒrii Ã®n luna curentÄƒ (ex: #007) â€” resetat lunar per business
  channel                 ChannelType
  notes                   String?
  depositPaid             Boolean       @default(false)
  reminder24hSent         Boolean       @default(false) // reminder-ul principal, trimis cu o zi Ã®nainte la ora 16:00 â€” cere reconfirmare activÄƒ
  reminder1hSent          Boolean       @default(false) // reminder-ul scurt, trimis cu 2 ore Ã®nainte, Ã®n ziua programÄƒrii
  confirmationRequestSent Boolean       @default(false) // am cerut deja confirmare activÄƒ clientului
  customerConfirmed       Boolean? // null = fÄƒrÄƒ rÄƒspuns Ã®ncÄƒ, true = a confirmat (status devine CONFIRMED), false = a anulat (status devine CANCELLED)
  confirmationSeenByAdmin Boolean       @default(true) // false = clientul tocmai a confirmat, admin-ul n-a vÄƒzut Ã®ncÄƒ (notificare Ã®n meniu)
  unconfirmedAlertSent    Boolean       @default(false) // am anunÈ›at deja proprietarul cÄƒ rezervarea asta n-a fost confirmatÄƒ
  createdAt               DateTime      @default(now())
  googleCalendarEventId   String?
  googleCalendarSyncedAt  DateTime?
  googleCalendarSyncError String?
  review                  Review?

  // interogÄƒrile reale (calendar, disponibilitate, reminder-e, statistici) filtreazÄƒ
  // aproape mereu dupÄƒ businessId + un al doilea criteriu â€” fÄƒrÄƒ aceste indexuri,
  // Postgres scaneazÄƒ tabelul Ã®ntreg de fiecare datÄƒ, la orice volum mai mare
  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([businessId, confirmationSeenByAdmin])
  @@index([customerId])
  @@index([practitionerId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  weekday    Int
  startTime  String
  endTime    String

  @@index([businessId, weekday])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Channels (WhatsApp / Instagram / Facebook / Google)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Channel {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id])
  type           ChannelType
  externalId     String
  wabaId         String? // doar pentru WHATSAPP â€” WhatsApp Business Account ID, diferit de phone_number_id
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  status         ChannelStatus @default(ACTIVE)
  enabledByOwner Boolean       @default(true)
  connectedAt    DateTime      @default(now())

  @@unique([type, externalId])
  @@index([businessId, type])
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE_BUSINESS
  WEB
  MANUAL
}

enum ChannelStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DISCONNECTED
}

model Conversation {
  id                  String      @id @default(cuid())
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id])
  channel             ChannelType
  externalUserId      String
  state               Json
  needsOperator       Boolean     @default(false) // clientul a cerut un operator, aÈ™teaptÄƒ rÄƒspuns uman
  operatorRequestedAt DateTime? // momentul exact al ultimei cereri de operator â€” inbox-ul aratÄƒ mesajele doar de-atunci Ã®ncolo, nu tot istoricul cu botul
  updatedAt           DateTime    @updatedAt

  @@index([businessId, needsOperator])
  @@index([businessId, channel, externalUserId])
}

model MessageTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  title      String // eticheta scurtÄƒ, pentru identificare rapidÄƒ Ã®n listÄƒ
  text       String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  channel        ChannelType
  externalUserId String
  direction      MessageDirection
  text           String
  createdAt      DateTime         @default(now())

  @@index([businessId, channel, externalUserId, createdAt])
}

enum MessageDirection {
  IN
  OUT
}

model BusinessPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  url        String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model Review {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  bookingId        String?  @unique
  booking          Booking? @relation(fields: [bookingId], references: [id])
  source           String   @default("bookeasy") // "bookeasy" = recenzie realÄƒ de la client, "google" = sincronizatÄƒ din Google Business Profile
  externalReviewId String? // ID-ul recenziei la sursÄƒ (Google etc.) â€” evitÄƒ duplicate la resincronizare
  authorName       String
  rating           Int
  comment          String?
  reply            String?
  createdAt        DateTime @default(now())

  @@unique([businessId, source, externalReviewId])
  @@index([businessId])
}

model BlockedSlot {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// â”€â”€â”€ Clinici (medici cu program propriu, separat de programul general al afacerii) â”€â”€â”€

model Practitioner {
  id             String                     @id @default(cuid())
  businessId     String
  business       Business                   @relation(fields: [businessId], references: [id])
  name           String
  specialization String?
  photoUrl       String?
  bio            String?
  active         Boolean                    @default(true)
  break1Start    String? // pauze zilnice (ex: masÄƒ) â€” aceleaÈ™i ore Ã®n fiecare zi lucrÄƒtoare
  break1End      String?
  break2Start    String?
  break2End      String?
  break3Start    String?
  break3End      String?
  createdAt      DateTime                   @default(now())
  workingHours   PractitionerWorkingHours[]
  services       ServicePractitioner[]
  bookings       Booking[]
  googleCalendar GoogleCalendarConnection?

  @@index([businessId, active])
}

model GoogleCalendarConnection {
  id                     String       @id @default(cuid())
  businessId             String
  business               Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  practitionerId         String       @unique
  practitioner           Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  googleEmail            String?
  calendarId             String
  calendarName           String
  accessToken            String
  refreshToken           String?
  expiresAt              DateTime?
  syncEnabled            Boolean      @default(true)
  includeCustomerDetails Boolean      @default(false)
  lastSyncAt             DateTime?
  lastError              String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([businessId])
}

model PractitionerWorkingHours {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  weekday        Int
  startTime      String
  endTime        String
}

// legÄƒturÄƒ many-to-many: un serviciu poate fi oferit de mai mulÈ›i medici, un medic poate
// oferi mai multe servicii â€” dacÄƒ un serviciu nu are niciun medic asociat, e considerat
// disponibil la orice medic (comportament implicit, mai simplu pentru clinici mici)
model ServicePractitioner {
  id             String       @id @default(cuid())
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])

  @@unique([serviceId, practitionerId])
}

// â”€â”€â”€ FiÈ™Äƒ medicalÄƒ completÄƒ (opÈ›ionalÄƒ, doar clinici) â€” inspiratÄƒ din fiÈ™ele
// stomatologice/medicale reale. CÃ¢mpurile "des consultate" rÄƒmÃ¢n dedicate, iar
// listele lungi de tip da/nu (afecÈ›iuni, temeri) sunt stocate ca JSON, ca fiÈ™a sÄƒ
// rÄƒmÃ¢nÄƒ uÈ™or de extins fÄƒrÄƒ migrÄƒri noi de fiecare datÄƒ â”€â”€â”€

model PatientMedicalRecord {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  cnp                   String?
  address               String?
  city                  String?
  occupation            String?
  emergencyContactName  String?
  emergencyContactPhone String?

  familyDoctor             String?
  familyDoctorLastVisit    String?
  previousDentist          String?
  previousDentistLastVisit String?

  hospitalized        Boolean?
  hospitalizedDetails String?
  surgeries           Boolean?
  surgeriesDetails    String?
  onMedication        Boolean?
  medicationDetails   String?
  smoker              Boolean?

  allergyAnesthesia  Boolean?
  allergyAntibiotics Boolean?
  allergyAspirin     Boolean?
  allergyIodine      Boolean?
  allergyLatex       Boolean?
  allergyNickel      Boolean?
  allergyOther       String?

  pregnant            Boolean?
  pregnantMonth       String?
  breastfeeding       Boolean?
  menstruationStarted Boolean?
  contraceptives      Boolean?
  menopause           Boolean?

  medicalConditions Json? // checklist tip {hipertensiune: true, diabet: false, ...}
  dentalHistory     Json? // pÄƒstrat pentru compatibilitate â€” nu mai e folosit de fiÈ™a generalÄƒ
  clinicalHistory   Json? // fiÈ™Äƒ generalÄƒ, orice specialitate: motivul vizitei, istoric familial, semne vitale
  pediatricInfo     Json? // Ã®nÄƒlÈ›ime, greutate, obiceiuri copii â€” doar dacÄƒ e cazul

  generalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  url        String
  filename   String
  uploadedAt DateTime @default(now())

  @@index([customerId])
}

model MedicalLetter {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  providerName   String? // Denumire Furnizor
  doctorName     String? // Medic
  contractNumber String? // Contract/convenÈ›ie nr.
  casName        String? // CAS

  patientName           String?
  patientBirthDate      String?
  patientCnp            String?
  consultationDate      String?
  hospitalizationPeriod String?
  fileNumber            String? // nr. F.O. / Registrul de consultaÈ›ii

  presentationReasons  String?
  oncologicalDiagnosis Boolean?
  diagnosis            String?

  anamnesis   String?
  riskFactors String?

  clinicalExamGeneral String?
  clinicalExamLocal   String?

  labNormal       String?
  labPathological String?

  ekg               String?
  eco               String?
  rx                String?
  otherParaclinical String?

  treatmentGiven       String?
  otherHealthInfo      String?
  recommendedTreatment String?

  returnForHospitalization String? // "da, in termen de X" / "nu"
  prescriptionStatus       String? // una din cele 3 opÈ›iuni
  medicalLeaveStatus       String? // una din cele 3 opÈ›iuni
  homeCareStatus           String? // una din cele 2 opÈ›iuni
  deviceStatus             String? // una din cele 2 opÈ›iuni

  letterDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  businessName String
  email        String
  phone        String
  category     BusinessType?
  message      String?
  status       AccessRequestStatus @default(NEW)
  createdAt    DateTime            @default(now())
}

model SupportTicket {
  id         String              @id @default(cuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id])
  subject    String
  message    String
  status     SupportTicketStatus @default(NEW)
  reply      String? // rÄƒspunsul tÄƒu, vizibil apoi È™i adminului afacerii
  repliedAt  DateTime?
  createdAt  DateTime            @default(now())

  @@index([businessId])
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum AccessRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  serviceId      String
  service        Service        @relation(fields: [serviceId], references: [id])
  practitionerId String? // opÈ›ional â€” dacÄƒ vrea strict o anumitÄƒ persoanÄƒ, nu oricine e liber
  desiredDate    DateTime // ziua doritÄƒ (00:00) â€” dacÄƒ se elibereazÄƒ un loc Ã®n acea zi, e anunÈ›at primul din listÄƒ
  status         WaitlistStatus @default(WAITING)
  notifiedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([businessId, serviceId, desiredDate, status])
}

