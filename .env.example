# Database (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# App
APP_URL="http://localhost:3000"
TZ="Europe/Bucharest"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Encryption (32-byte key, hex-encoded, for token storage)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Anthropic (bot NLU)
ANTHROPIC_API_KEY=""

# Meta (WhatsApp / Instagram / Facebook)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="alege-un-string-random"

# Google (Business Profile + Google Calendar OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Authorized redirect URI: https://domeniul-tau.ro/api/google-calendar/callback

# Google Maps (hartă publică + geocoding la onboarding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (email)
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""

# Vercel Blob (poze publice + documente medicale private)
BLOB_READ_WRITE_TOKEN=""
BOOKBLOB_STORE_ID=""
DOCMED_STORE_ID=""

# Cron protection
CRON_SECRET="alege-un-string-random"
